# Build output
dist/
build/
/target/
# mygo dev 的开发版构建目录
/.mygo/
# 旧 Tauri 外壳的本地构建缓存
/src-tauri/
desktop/packaging/windows-shell-extension/bin/
desktop/packaging/windows-shell-extension/obj/
desktop/packaging/windows-shell-extension/obj-tests/
.artifacts/

# Local environment
.env
.env.*
!.env.example
*.local

# Logs and caches
*.log
logs/
.cache/
.temp/
.tmp/
/.tmp-*/

# Editor and OS files
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# Local video production assets
/video/

# 导出精细排版的 WebAssembly 构建产物（scripts/kpwasm 生成）
/desktop/ui/kpexport/gen/*
!/desktop/ui/kpexport/gen/.gitkeep

