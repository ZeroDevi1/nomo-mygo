{
  "name": "Nomo Scholar",
  "slug": "nomo",
  "identifier": "com.nomo.scholar",
  "version": "0.9.0",
  "icon": "desktop/packaging/icons/nomo/source/nomo-app-light-1024.png",
  "main": "./desktop",
  "out": "target/mygo",
  "buildCommand": "go run ./scripts/typeset-assets && go run ./scripts/kpwasm",
  "resources": ["desktop/packaging/samples"],
  "fileAssociations": [
    { "ext": ["md", "markdown"], "name": "Markdown Document", "mimeType": "text/markdown", "role": "Editor" },
    { "ext": ["txt"], "name": "Text Document", "mimeType": "text/plain", "role": "Editor" },
    { "ext": ["json"], "name": "JSON Document", "mimeType": "application/json", "role": "Editor" },
    { "ext": ["tex", "ltx"], "name": "LaTeX Source", "mimeType": "text/x-tex", "role": "Editor" },
    { "ext": ["typ"], "name": "Typst Source", "mimeType": "text/x-typst", "role": "Editor" }
  ],
  "macos": {
    "minimumSystemVersion": "12.0",
    "icon": "desktop/packaging/icons/nomo/macos/AppIcon.icon",
    "infoPlist": {
      "CFBundleDevelopmentRegion": "en",
      "CFBundleLocalizations": ["en", "zh-Hans", "zh-Hant", "ja"],
      "CFBundlePlugIns": ["Contents/PlugIns/NomoQuickLookPreview.appex"],
      "CFBundleDocumentTypes": [
        { "CFBundleTypeName": "Markdown Document", "CFBundleTypeRole": "Editor", "LSHandlerRank": "Default", "LSItemContentTypes": ["net.daringfireball.markdown", "public.markdown"] },
        { "CFBundleTypeName": "Text Document", "CFBundleTypeRole": "Editor", "LSHandlerRank": "Default", "LSItemContentTypes": ["public.plain-text"] },
        { "CFBundleTypeName": "JSON Document", "CFBundleTypeRole": "Editor", "LSHandlerRank": "Default", "LSItemContentTypes": ["public.json"] },
        { "CFBundleTypeName": "LaTeX Source", "CFBundleTypeRole": "Editor", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["org.tug.tex", "org.tug.ltx", "public.tex"] },
        { "CFBundleTypeName": "Typst Source", "CFBundleTypeRole": "Editor", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["org.typst.document"] }
      ],
      "UTImportedTypeDeclarations": [
        {
          "UTTypeIdentifier": "org.tug.tex",
          "UTTypeDescription": "TeX Source",
          "UTTypeConformsTo": ["public.plain-text"],
          "UTTypeTagSpecification": {
            "public.filename-extension": ["tex"],
            "public.mime-type": ["text/x-tex"]
          }
        },
        {
          "UTTypeIdentifier": "org.tug.ltx",
          "UTTypeDescription": "LaTeX Source",
          "UTTypeConformsTo": ["public.plain-text"],
          "UTTypeTagSpecification": {
            "public.filename-extension": ["ltx"]
          }
        },
        {
          "UTTypeIdentifier": "org.typst.document",
          "UTTypeDescription": "Typst Source",
          "UTTypeConformsTo": ["public.plain-text"],
          "UTTypeTagSpecification": {
            "public.filename-extension": ["typ"],
            "public.mime-type": ["text/x-typst"]
          }
        }
      ],
      "UTExportedTypeDeclarations": [
        {
          "UTTypeIdentifier": "net.daringfireball.markdown",
          "UTTypeDescription": "Markdown Document",
          "UTTypeConformsTo": ["public.plain-text", "public.text"],
          "UTTypeTagSpecification": {
            "public.filename-extension": ["md", "markdown", "mdown", "mkd"],
            "public.mime-type": ["text/markdown"]
          }
        }
      ]
    }
  }
}
